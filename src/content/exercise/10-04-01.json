  "title": "Transformar una tabla",
  "description": "Sustituir una cuadrícula por reglas de booktabs.",
  "instructions": "Elimina las barras verticales y los hline. Usa toprule, midrule y bottomrule sin cambiar los datos.",
  "required": true,
  "initialCode": "\\documentclass{article}\n\\usepackage{booktabs}\n\n\\begin{document}\n\\begin{tabular}{|l|r|}\n\\hline\nGrupo & Media \\\\\n\\hline\nA & 14.2 \\\\\nB & 15.1 \\\\\n\\hline\n\\end{tabular}\n\\end{document}",
