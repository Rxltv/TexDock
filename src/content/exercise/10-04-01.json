  "objective": "Aplicar el estilo booktabs y retirar la cuadrícula.",
  "canonicalSolution": "\\documentclass{article}\n\\usepackage{booktabs}\n\n\\begin{document}\n\\begin{tabular}{lr}\n\\toprule\nGrupo & Media \\\\\n\\midrule\nA & 14.2 \\\\\nB & 15.1 \\\\\n\\bottomrule\n\\end{tabular}\n\\end{document}",
