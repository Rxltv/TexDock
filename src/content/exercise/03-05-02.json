      "required": true,
      "scope": "PREAMBLE",
      "target": "\\documentclass",
      "feedback": "Falta \\documentclass."
    },
    {
      "id": "vr-03-05-02-req-article",
      "type": "REQUIRE_ARGUMENT",
      "required": true,
      "scope": "PREAMBLE",
      "target": "\\documentclass",
      "expected": "article",
      "feedback": "La clase debe ser article."
    },
    {
      "id": "vr-03-05-02-no-docclass-body",
      "type": "FORBID_ALTERNATIVE",
      "required": true,
      "scope": "BODY",
      "target": "\\documentclass",
      "feedback": "\\documentclass debe declararse en el preámbulo."
    },
    {
      "id": "vr-03-05-02-req-fontenc",
      "type": "REQUIRE_PACKAGE",
      "required": true,
      "scope": "PREAMBLE",
      "target": "fontenc",
      "expected": "T1",
      "feedback": "Falta fontenc."
    },
    {
      "id": "vr-03-05-02-req-inputenc",
      "type": "REQUIRE_PACKAGE",
      "required": true,
      "scope": "PREAMBLE",
      "target": "inputenc",
      "expected": "utf8",
      "feedback": "Falta inputenc."
    },
    {
      "id": "vr-03-05-02-req-babel",
      "type": "REQUIRE_PACKAGE",
      "required": true,
      "scope": "PREAMBLE",
      "target": "babel",
      "expected": "spanish",
      "feedback": "Falta babel."
    },
    {
      "id": "vr-03-05-02-req-order",
      "type": "REQUIRE_ORDER",
      "required": true,
      "scope": "PREAMBLE",
      "arguments": [
