  "objective": "Construir la plantilla completa en español desde cero, reuniendo clase, paquetes y entorno document.",
  "canonicalSolution": "\\documentclass{article}\n\n\\usepackage[T1]{fontenc}\n\\usepackage[utf8]{inputenc}\n\\usepackage[spanish]{babel}\n\n\\begin{document}\nEste documento está configurado para escribir en español.\n\\end{document}",
  "validationRules": [
    {
