---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const sections = await getCollection('section');
const sortedSections = sections
  .map((s) => s.data)
  .sort((a, b) => a.order - b.order);
const totalSections = sortedSections.length;
---

<BaseLayout title="TexDock — Aprende LaTeX escribiendo">
  <main>
    <section class="hero">
      <h1>TexDock</h1>
      <p class="tagline">Aprende LaTeX escribiendo</p>
      <p class="subtitle">
        Plataforma educativa, minimalista y de código abierto para enseñar
        LaTeX con teoría breve, ejercicios prácticos y visualización inmediata.
      </p>
      <div class="cta-group">
        <a href="/aprender" class="cta-primary">
          Comenzar curso básico
        </a>
        <a href="/laboratorio" class="cta-secondary">
          Laboratorio matemático
        </a>
      </div>
    </section>

    <section class="course-summary" aria-labelledby="course-heading">
      <h2 id="course-heading">Curso básico de LaTeX</h2>
      <p>
        {totalSections} secciones que cubren desde los fundamentos hasta la
        creación de un documento académico completo.
      </p>
      <ol class="section-list">
        {
          sortedSections.map((section) => (
            <li>
              <a href={`/aprender/${section.id}`}>
                {section.order}. {section.title}
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="features" aria-labelledby="features-heading">
      <h2 id="features-heading">Características</h2>
      <ul class="feature-grid">
        <li class="feature-card">
          <h3>Editor con resaltado</h3>
          <p>Escribe LaTeX con resaltado de sintaxis y números de línea.</p>
        </li>
        <li class="feature-card">
          <h3>Vista previa inmediata</h3>
          <p>Visualiza el resultado al instante con KaTeX.</p>
        </li>
        <li class="feature-card">
          <h3>Ejercicios prácticos</h3>
          <p>Pon a prueba lo aprendido con ejercicios integrados.</p>
        </li>
        <li class="feature-card">
          <h3>Progreso local</h3>
          <p>Tu avance se guarda automáticamente en el navegador.</p>
        </li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: var(--space-lg);
    text-align: center;
  }

  .hero h1 {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .tagline {
    font-size: clamp(1rem, 3vw, 1.5rem);
    color: var(--color-accent);
    margin-bottom: var(--space-lg);
    font-weight: 600;
  }

  .subtitle {
    max-width: var(--max-width);
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .cta-group {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }

  .cta-primary {
    background: var(--color-accent-dim);
    color: var(--color-text);
    border: 1px solid var(--color-accent);
  }

  .cta-primary:hover {
    background: var(--color-accent);
    color: var(--color-text);
  }

  .cta-secondary {
    background: var(--color-surface);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .cta-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .course-summary {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .course-summary h2 {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .course-summary > p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .section-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    counter-reset: section-counter;
  }

  .section-list li a {
    display: block;
    padding: var(--space-sm) var(--space-md);
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius);
    font-size: 0.9375rem;
  }

  .section-list li a:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .features {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .features h2 {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    margin-bottom: var(--space-lg);
    color: var(--color-text);
  }

  .feature-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-md);
  }

  .feature-card {
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .feature-card h3 {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--space-sm);
    color: var(--color-text);
  }

  .feature-card p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  @media (width <= 480px) {
    .hero {
      min-height: 50vh;
      padding: var(--space-lg) var(--space-md);
    }

    .course-summary,
    .features {
      padding: var(--space-lg) var(--space-md);
    }
  }
</style>
