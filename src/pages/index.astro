---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="TexDock — Aprende LaTeX escribiendo">
  <header>
    <nav aria-label="Navegación principal">
      <span class="logo">TexDock</span>
      <span class="badge">Fase 0</span>
    </nav>
  </header>

  <main>
    <section class="hero">
      <h1>TexDock</h1>
      <p class="tagline">Aprende LaTeX escribiendo</p>
      <p class="subtitle">
        Plataforma educativa, minimalista y de código abierto para enseñar
        LaTeX con teoría breve, ejercicios prácticos y visualización inmediata.
      </p>
    </section>

    <section class="status" aria-labelledby="status-heading">
      <h2 id="status-heading">Laboratorio matemático</h2>
      <p>
        El laboratorio interactivo donde podrás escribir y previsualizar
        expresiones en LaTeX se encuentra en preparación.
      </p>
      <p>
        Esta es la portada provisional de TexDock. Mientras tanto, el equipo
        trabaja en construir una experiencia de aprendizaje sólida desde la
        base.
      </p>
    </section>
  </main>

  <footer>
    <p>
      <span aria-hidden="true">TexDock</span>
      <span class="visually-hidden">TexDock</span>
      &nbsp;— Código abierto &middot; En desarrollo
    </p>
  </footer>
</BaseLayout>

<style is:global>
  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-accent);
  }

  .badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: var(--space-lg);
    text-align: center;
  }

  .hero h1 {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .tagline {
    font-size: clamp(1rem, 3vw, 1.5rem);
    color: var(--color-accent);
    margin-bottom: var(--space-lg);
    font-weight: 600;
  }

  .subtitle {
    max-width: var(--max-width);
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .status {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .status h2 {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .status p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  footer {
    text-align: center;
    padding: var(--space-lg);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip: rect(0 0 0 0);
  }

  @media (width <= 480px) {
    .hero {
      min-height: 50vh;
      padding: var(--space-lg) var(--space-md);
    }

    nav {
      padding: var(--space-sm) var(--space-md);
    }

    .status {
      padding: var(--space-lg) var(--space-md);
    }
  }
</style>
