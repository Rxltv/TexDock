---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/urls';
import katex from 'katex';
import 'katex/dist/katex.min.css';

const kx = { displayMode: false, throwOnError: false };

const fgFormulas = {
  sum: katex.renderToString('\\sum_{n=1}^{\\infty}\\frac{1}{n^2}', kx),
  matrix: katex.renderToString('\\begin{pmatrix}a & b \\\\ c & d\\end{pmatrix}', kx),
  int: katex.renderToString('\\displaystyle\\int_0^1 x^2\\,dx', kx),
  euler: katex.renderToString('e^{i\\pi}+1=0', kx),
  parts: katex.renderToString('f(x)=\\begin{cases}x^2, & x \\ge 0 \\\\ -x, & x < 0\\end{cases}', kx),
  sqrt: katex.renderToString('\\sqrt{x^2+y^2}', kx),
  frac: katex.renderToString('\\dfrac{a+b}{c+d}', kx),
  limit: katex.renderToString('\\displaystyle\\lim_{x\\to 0}\\frac{\\sin x}{x}=1', kx),
};
---

<BaseLayout title="TexDock — Aprende LaTeX escribiendo" hideFooter pageLayout="landing">
  <script is:inline>
    (() => {
      function updateCourseCta() {
        const cta = document.querySelector('[data-course-cta]');
        if (!cta) return;
        try {
          const raw = localStorage.getItem('texdock:progress');
          if (!raw) return;
          const state = JSON.parse(raw);
          if (state.schemaVersion !== 1 || !Array.isArray(state.completedLessons)) return;
          if (state.completedSections?.length >= 15) cta.textContent = 'Repasar curso básico';
          else if (state.completedLessons.length > 0) cta.textContent = 'Continuar curso básico';
        } catch {
          // A missing or invalid local state leaves the initial CTA unchanged.
        }
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', updateCourseCta);
      else updateCourseCta();
    })();
  </script>
  <main class="landing">
    <div class="landing-bg" aria-hidden="true">
      <span class="bg-item bg-documentclass">\documentclass&lbrace;article&rbrace;</span>
      <span class="bg-item bg-amsmath">\usepackage&lbrace;amsmath&rbrace;</span>
      <span class="bg-item bg-maketitle">\maketitle</span>
      <span class="bg-item bg-begindoc">\begin&lbrace;document&rbrace;</span>
      <span class="bg-item bg-textbf">\textbf&lbrace;texto&rbrace;</span>
      <span class="bg-item bg-section">\section&lbrace;Introducción&rbrace;</span>
      <span class="bg-item bg-noindent">\noindent</span>
      <span class="bg-item bg-enddoc">\end&lbrace;document&rbrace;</span>
    </div>
    <div class="landing-fg" aria-hidden="true">
      <span class="fg-item fg-sum"><span class="fg-sum-inner" set:html={fgFormulas.sum}></span></span>
      <span class="fg-item fg-matrix" set:html={fgFormulas.matrix}></span>
      <span class="fg-item fg-int" set:html={fgFormulas.int}></span>
      <span class="fg-item fg-euler" set:html={fgFormulas.euler}></span>
      <span class="fg-item fg-parts" set:html={fgFormulas.parts}></span>
      <span class="fg-item fg-sqrt" set:html={fgFormulas.sqrt}></span>
      <span class="fg-item fg-frac" set:html={fgFormulas.frac}></span>
      <span class="fg-item fg-limit" set:html={fgFormulas.limit}></span>
    </div>
    <section class="hero">
      <p class="hero-eyebrow">Curso de LaTeX</p>
      <h1 class="hero-title">TexDock</h1>
      <p class="hero-tagline">Aprende LaTeX escribiendo</p>
      <p class="hero-description">
        Plataforma educativa, minimalista y de código abierto para enseñar
        LaTeX con teoría breve, ejercicios prácticos y visualización inmediata.
      </p>
      <div class="hero-actions">
         <a href={url('/aprender')} class="btn btn--primary" data-course-cta>Comenzar curso básico</a>
        <a href={url('/laboratorio')} class="btn btn--secondary">Fórmulas</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .landing {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 0;
    padding: clamp(var(--space-lg), 5vw, var(--space-xl));
    position: relative;
    isolation: isolate;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: min(100%, 720px);
    z-index: 2;
    position: relative;
  }

  .hero-eyebrow {
    margin-bottom: var(--space-md);
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-title {
    font-family: var(--font-mono);
    font-size: clamp(4rem, 8vw, 6.5rem);
    font-weight: 800;
    line-height: 0.95;
    margin-bottom: var(--space-md);
    color: var(--color-text);
    letter-spacing: -0.055em;
  }

  .hero-tagline {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--color-text);
    margin-bottom: var(--space-md);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .hero-description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
    max-width: 620px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
    white-space: nowrap;
    min-height: 44px;
    padding-inline: var(--space-lg);
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s, transform 0.15s;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn:active {
    transform: translateY(0);
  }

  [data-theme="dark"] .btn--primary {
    background: #ffffff;
    color: #000000;
    border: 1px solid #ffffff;
  }

  [data-theme="dark"] .btn--primary:hover {
    background: #e0e0e0;
    color: #000000;
    border-color: #ffffff;
  }

  [data-theme="dark"] .btn--secondary {
    background: transparent;
    color: #ffffff;
    border: 1px solid #555555;
  }

  [data-theme="dark"] .btn--secondary:hover {
    background: #2a2a2a;
    color: #ffffff;
    border-color: #888888;
  }

  [data-theme="light"] .btn--primary {
    background: #000000;
    color: #ffffff;
    border: 1px solid #000000;
  }

  [data-theme="light"] .btn--primary:hover {
    background: #222222;
    color: #ffffff;
    border-color: #000000;
  }

  [data-theme="light"] .btn--secondary {
    background: #ffffff;
    color: #000000;
    border: 1px solid #999999;
  }

  [data-theme="light"] .btn--secondary:hover {
    background: #e8e8e8;
    color: #000000;
    border-color: #555555;
  }

  .hero .btn--primary {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .hero .btn--primary:hover {
    background: var(--color-text-secondary);
    color: var(--color-bg);
    border-color: var(--color-text-secondary);
  }

  .hero .btn--secondary {
    background: var(--color-surface);
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .hero .btn--secondary:hover {
    background: var(--color-surface-elevated);
    color: var(--color-text);
    border-color: var(--color-text-secondary);
  }

  .landing-bg,
  .landing-fg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  .landing-bg { z-index: 0; }
  .landing-fg { z-index: 1; }

  .bg-item {
    position: absolute;
    font-family: var(--font-mono);
    white-space: nowrap;
    line-height: 1;
  }

  .fg-item {
    position: absolute;
    white-space: nowrap;
    line-height: 1;
  }

  .fg-item .katex {
    font-size: inherit !important;
    line-height: inherit !important;
  }

  .fg-item .katex .katex-html {
    color: inherit;
  }

  .bg-documentclass {
    top: 10%;
    left: 7%;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    color: #d1d5db;
    opacity: 0.24;
    animation: bg-left 16s ease-in-out -2s infinite alternate;
  }

  .bg-amsmath {
    top: 8%;
    right: 6%;
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    color: #9ca3af;
    opacity: 0.22;
    animation: bg-right 18s ease-in-out -7s infinite alternate;
  }

  .bg-maketitle {
    top: 22%;
    right: 20%;
    font-size: clamp(0.95rem, 1.3vw, 1.2rem);
    color: #d1d5db;
    opacity: 0.2;
    animation: bg-right 19s ease-in-out -6s infinite alternate;
  }

  .bg-begindoc {
    top: 47%;
    left: 3%;
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    color: #f5f5f5;
    opacity: 0.2;
    animation: bg-left 15s ease-in-out -4s infinite alternate;
  }

  .bg-textbf {
    top: 44%;
    right: 4%;
    font-size: clamp(1rem, 1.5vw, 1.3rem);
    color: #d1d5db;
    opacity: 0.18;
    animation: bg-right 17s ease-in-out -11s infinite alternate;
  }

  .bg-section {
    bottom: 30%;
    left: 9%;
    font-size: clamp(1.1rem, 1.65vw, 1.45rem);
    color: #9ca3af;
    opacity: 0.22;
    animation: bg-left 14s ease-in-out -9s infinite alternate;
  }

  .bg-noindent {
    bottom: 31%;
    right: 8%;
    font-size: clamp(0.95rem, 1.4vw, 1.2rem);
    color: #ffffff;
    opacity: 0.18;
    animation: bg-right 20s ease-in-out -14s infinite alternate;
  }

  .bg-enddoc {
    bottom: 5%;
    right: 8%;
    font-size: clamp(1.1rem, 1.65vw, 1.45rem);
    color: #d1d5db;
    opacity: 0.22;
    animation: bg-right 13s ease-in-out -5s infinite alternate;
  }

  .fg-sum {
    top: 8%;
    left: 52%;
    transform: translateX(-50%);
    font-size: clamp(1.45rem, 2.3vw, 2.25rem);
    color: #a78bfa;
    opacity: 0.55;
    text-shadow: 0 0 14px color-mix(in srgb, #a78bfa 25%, transparent);
  }

  .fg-sum-inner {
    display: inline-block;
    animation: fg-up 12s ease-in-out -4s infinite alternate;
  }

  .fg-matrix {
    top: 16%;
    left: 24%;
    font-size: clamp(1.65rem, 2.5vw, 2.6rem);
    color: #c084fc;
    opacity: 0.62;
    text-shadow: 0 0 16px color-mix(in srgb, #c084fc 25%, transparent);
    animation: fg-up-right 11s ease-in-out -3s infinite alternate;
  }

  .fg-int {
    top: 37%;
    left: 7%;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    color: #4ade80;
    opacity: 0.68;
    text-shadow: 0 0 18px color-mix(in srgb, #4ade80 25%, transparent);
    animation: fg-down-left 10s ease-in-out -7s infinite alternate;
  }

  .fg-euler {
    top: 26%;
    right: 7%;
    font-size: clamp(1.7rem, 2.9vw, 2.8rem);
    color: #fb923c;
    opacity: 0.62;
    text-shadow: 0 0 16px color-mix(in srgb, #fb923c 25%, transparent);
    animation: fg-up-right 13s ease-in-out -11s infinite alternate;
  }

  .fg-parts {
    bottom: 18%;
    left: 8%;
    font-size: clamp(1.7rem, 2.6vw, 2.7rem);
    color: #fb7185;
    opacity: 0.66;
    text-shadow: 0 0 16px color-mix(in srgb, #fb7185 25%, transparent);
    animation: fg-down-right 14s ease-in-out -2s infinite alternate;
  }

  .fg-sqrt {
    bottom: 14%;
    left: 80%;
    font-size: clamp(1.5rem, 2.4vw, 2.3rem);
    color: #38bdf8;
    opacity: 0.64;
    text-shadow: 0 0 16px color-mix(in srgb, #38bdf8 25%, transparent);
    animation: fg-up-left 9s ease-in-out -5s infinite alternate;
  }

  .fg-frac {
    bottom: 13%;
    right: 30%;
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    color: #fbbf24;
    opacity: 0.66;
    text-shadow: 0 0 18px color-mix(in srgb, #fbbf24 25%, transparent);
    animation: fg-down-right 15s ease-in-out -9s infinite alternate;
  }

  .fg-limit {
    bottom: 42%;
    right: 8%;
    font-size: clamp(1.5rem, 2.2vw, 2.2rem);
    color: #818cf8;
    opacity: 0.62;
    text-shadow: 0 0 14px color-mix(in srgb, #818cf8 25%, transparent);
    animation: fg-up-left 12s ease-in-out -8s infinite alternate;
  }

  [data-theme="light"] .bg-documentclass { color: #1f2937; opacity: 0.36; }
  [data-theme="light"] .bg-amsmath { color: #374151; opacity: 0.34; }
  [data-theme="light"] .bg-maketitle { color: #1f2937; opacity: 0.32; }
  [data-theme="light"] .bg-begindoc { color: #111111; opacity: 0.32; }
  [data-theme="light"] .bg-textbf { color: #374151; opacity: 0.30; }
  [data-theme="light"] .bg-section { color: #1f2937; opacity: 0.36; }
  [data-theme="light"] .bg-noindent { color: #111111; opacity: 0.32; }
  [data-theme="light"] .bg-enddoc { color: #374151; opacity: 0.36; }

  [data-theme="light"] .fg-sum { color: #5b21b6; opacity: 0.82; text-shadow: none; }
  [data-theme="light"] .fg-matrix { color: #075985; opacity: 0.82; text-shadow: none; }
  [data-theme="light"] .fg-int { color: #166534; opacity: 0.86; text-shadow: none; }
  [data-theme="light"] .fg-euler { color: #9a3412; opacity: 0.82; text-shadow: none; }
  [data-theme="light"] .fg-parts { color: #9f1239; opacity: 0.86; text-shadow: none; }
  [data-theme="light"] .fg-sqrt { color: #075985; opacity: 0.82; text-shadow: none; }
  [data-theme="light"] .fg-frac { color: #854d0e; opacity: 0.84; text-shadow: none; }
  [data-theme="light"] .fg-limit { color: #4338ca; opacity: 0.82; text-shadow: none; }

  .landing-fg .fg-item {
    color: var(--color-text-secondary);
    opacity: 0.28;
    text-shadow: none;
  }

  .landing-fg .fg-int {
    color: var(--color-code);
    opacity: 0.42;
  }

  .landing-fg .fg-euler {
    color: var(--color-practice);
    opacity: 0.4;
  }

  @keyframes fg-up {
    from { transform: translate(0, 0); }
    to   { transform: translate(0, -32px); }
  }

  @keyframes fg-up-left {
    from { transform: translate(0, 0); }
    to   { transform: translate(-26px, -20px); }
  }

  @keyframes fg-up-right {
    from { transform: translate(0, 0); }
    to   { transform: translate(26px, -20px); }
  }

  @keyframes fg-down-left {
    from { transform: translate(0, 0); }
    to   { transform: translate(-22px, 24px); }
  }

  @keyframes fg-down-right {
    from { transform: translate(0, 0); }
    to   { transform: translate(22px, 24px); }
  }

  @keyframes bg-left {
    from { transform: translate(0, 0); }
    to   { transform: translate(-14px, 8px); }
  }

  @keyframes bg-right {
    from { transform: translate(0, 0); }
    to   { transform: translate(14px, -8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .fg-sum {
      transform: translateX(-50%) !important;
    }
    .fg-sum-inner {
      animation: none !important;
      transform: none !important;
    }
    .fg-item:not(.fg-sum),
    .bg-item {
      animation: none !important;
      transform: none !important;
    }
  }

  @media (width <= 768px) {
    .landing {
      min-height: calc(100svh - 7rem);
      padding: var(--space-xl) var(--space-md);
    }
    .landing-bg {
      display: none;
    }
    .landing-fg .fg-item {
      display: none;
    }
    .landing-fg .fg-sum,
    .landing-fg .fg-frac {
      display: block;
      opacity: 0.16;
      color: var(--color-text-secondary);
      text-shadow: none;
    }
    .landing-fg .fg-sum {
      top: 3%;
      left: 50%;
    }
    .landing-fg .fg-frac {
      right: 6%;
      bottom: 3%;
    }
    .hero-description {
      max-width: 100%;
    }
    .hero-actions {
      width: min(100%, 22rem);
    }
    .hero-actions .btn {
      flex: 1 1 9rem;
    }
  }

  @media (width <= 420px) {
    .landing {
      padding-block: calc(var(--space-xl) * 0.8);
    }
    .hero-title {
      font-size: clamp(3.25rem, 20vw, 4.5rem);
    }
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions .btn {
      flex-basis: auto;
      width: 100%;
    }
  }
</style>
