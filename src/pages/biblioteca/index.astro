---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TemplateCard from '../../components/library/TemplateCard.astro';
import { libraryTemplates } from '../../lib/library/templates';
---

<BaseLayout title="Biblioteca — TexDock" description="Plantillas LaTeX educativas para copiar y adaptar.">
  <main class="content-page" id="main-content">
    <h1>Biblioteca</h1>
    <p class="intro">Recursos públicos para escribir documentos LaTeX. Copia una plantilla y adáptala a tu próximo trabajo.</p>
    <div class="library-layout">
      <aside aria-label="Categorías de la biblioteca">
        <p class="category-label">Categoría</p>
        <strong>Plantillas</strong>
      </aside>
      <section aria-labelledby="templates-heading">
        <h2 id="templates-heading">Plantillas</h2>
        <div class="template-list">
          {libraryTemplates.map((template) => <TemplateCard template={template} />)}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .content-page { width: min(100% - 2rem, 1100px); margin: 0 auto; padding: var(--space-xl) 0; }
  h1 { font-family: var(--font-mono); font-size: 1.5rem; }
  .intro { max-width: 48rem; margin: var(--space-sm) 0 var(--space-xl); color: var(--color-text-secondary); line-height: 1.7; }
  .library-layout { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: var(--space-xl); align-items: start; }
  aside { position: sticky; top: var(--space-md); padding: var(--space-sm); border-left: 2px solid var(--color-navigation); background: var(--color-surface); }
  .category-label { margin: 0 0 var(--space-xs); color: var(--color-text-secondary); font: 0.6875rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em; }
  h2 { margin-bottom: var(--space-md); font-family: var(--font-mono); font-size: 1.125rem; }
  .template-list { display: grid; gap: var(--space-lg); }
  @media (max-width: 700px) { .content-page { padding: var(--space-lg) 0; } .library-layout { grid-template-columns: 1fr; gap: var(--space-lg); } aside { position: static; } }
</style>
