---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Biblioteca — TexDock">
  <main class="content-page">
    <h1>Biblioteca</h1>
    <p class="intro">
      Recursos y plantillas para ayudarte a escribir documentos LaTeX.
    </p>

    <section aria-labelledby="templates-heading">
      <h2 id="templates-heading">Plantillas beta</h2>
      <div class="template-list">
        <div class="template-card">
          <div class="template-info">
            <h3 class="template-name">Plantilla de libro</h3>
            <p class="template-desc">
              Estructura completa para libros y documentos extensos con clase
              <code>book</code>, capítulos, teoremas, apéndices y formato profesional.
            </p>
            <span class="template-format">formato .tex</span>
          </div>
          <a
            class="template-download"
            href="/plantillas/plantilla_libro.tex"
            download="plantilla_libro.tex"
          >
            Descargar .tex
          </a>
        </div>
        <div class="template-card">
          <div class="template-info">
            <h3 class="template-name">Plantilla de tareas</h3>
            <p class="template-desc">
              Base ligera para tareas, ejercicios y entregas académicas con clase
              <code>article</code>, entorno de problemas y encabezado personalizado.
            </p>
            <span class="template-format">formato .tex</span>
          </div>
          <a
            class="template-download"
            href="/plantillas/plantilla_tareas.tex"
            download="plantilla_tareas.tex"
          >
            Descargar .tex
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .content-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
  }

  h1 {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
    color: var(--color-text);
  }

  .intro {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .template-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .template-card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .template-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
  }

  .template-name {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .template-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .template-desc code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .template-format {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .template-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius);
    text-decoration: none;
    background: var(--color-text);
    color: var(--color-bg);
    border: 1px solid var(--color-text);
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }

  .template-download:hover {
    background: var(--color-text-secondary);
    border-color: var(--color-text-secondary);
  }

  .template-download:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
