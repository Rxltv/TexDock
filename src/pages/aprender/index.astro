---
import CourseLayout from '../../layouts/CourseLayout.astro';
import { getCollection } from 'astro:content';

const sections = await getCollection('section');
const sortedSections = sections
  .map((s) => s.data)
  .sort((a, b) => a.order - b.order);
---

<CourseLayout title="Aprender LaTeX — TexDock">
  <h1>Curso básico de LaTeX</h1>
  <p class="intro">
    Este curso está compuesto por {sortedSections.length} secciones. Cada
    sección incluye teoría breve, ejemplos interactivos y ejercicios prácticos.
  </p>

  <ol class="sections-overview">
    {
      sortedSections.map((section) => (
        <li class="section-card">
          <a href={`/aprender/${section.id}`}>
            <span class="section-number">Sección {section.order}</span>
            <span class="section-title">{section.title}</span>
            <span class="section-description">{section.description}</span>
          </a>
        </li>
      ))
    }
  </ol>
</CourseLayout>

<style>
  h1 {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .intro {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .sections-overview {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .section-card a {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .section-card a:hover {
    border-color: var(--color-accent);
  }

  .section-card a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .section-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .section-description {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>
