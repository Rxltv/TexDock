---
import CourseLayout from '../../layouts/CourseLayout.astro';
import LessonResources from '../../components/content/LessonResources.astro';
import LessonNavigation from '../../components/navigation/LessonNavigation.astro';
import { getCollection, render } from 'astro:content';
import {
  buildCourseSequence,
  getAdjacentPages,
  buildPagePath,
  type CourseNavigationEntry,
} from '../../lib/content/courseNavigation';
import { isVisible, buildPageSlug } from '../../lib/content/courseRouteData';
import { getLessonResourcesByPageId } from '../../lib/content/lessonResources';

export async function getStaticPaths() {
  const sections = await getCollection('section');
  const allLessons = await getCollection('lesson');
  const allPages = await getCollection('lessonPage');
  const allExercises = await getCollection('exercise');
  const isDev = import.meta.env.DEV;

  const visibleLessonData = allLessons
    .map((l) => l.data)
    .filter((l) => isVisible(l, isDev));
  const visiblePageData = allPages
    .map((p) => p.data)
    .filter((p) => isVisible(p, isDev));
  const requiredPageIds = new Set(
    allExercises
      .map((exercise) => exercise.data)
      .filter((exercise) => isVisible(exercise, isDev) && exercise.required)
      .map((exercise) => exercise.pageId),
  );
  const navSections = sections.map((s) => ({ id: s.data.id, order: s.data.order }));
  const sequence = buildCourseSequence(navSections, visibleLessonData, visiblePageData);

  const sectionsWithPages = new Set(sequence.map((entry) => entry.sectionId));
  const sectionPaths = sections
    .filter((section) => sectionsWithPages.has(section.data.id))
    .map((section) => ({
      params: { slug: section.data.id },
      props: { type: 'section' as const, section, lesson: undefined as any },
    }));

  const sectionMap = new Map(sections.map((s) => [s.data.id, s]));
  const lessonMap = new Map(allLessons.map((l) => [l.data.id, l]));
  const pageMap = new Map(allPages.map((p) => [p.data.id, p]));

  const pagePaths = [];
  for (const entry of sequence) {
    const section = sectionMap.get(entry.sectionId);
    const lesson = lessonMap.get(entry.lessonId);
    const lessonPage = pageMap.get(entry.pageId);
    if (!section || !lesson || !lessonPage) continue;

    const { previous, next } = getAdjacentPages(sequence, entry.pageId);
    const prevHref = previous ? buildPagePath(previous) : null;
    const nextHref = next ? buildPagePath(next) : null;

    pagePaths.push({
      params: { slug: buildPageSlug(entry) },
      props: {
        type: 'page' as const,
        section,
        lesson,
        lessonPage,
        entry,
        prevHref,
        nextHref,
        previousEntry: previous,
        nextEntry: next,
        previousInitiallyEnabled: Boolean(previous),
        nextInitiallyEnabled: Boolean(next) && !requiredPageIds.has(entry.pageId),
      },
    });
  }

  return [...sectionPaths, ...pagePaths];
}

type PageProps = {
  type: 'page';
  section: any;
  lesson: any;
  lessonPage: any;
  entry: CourseNavigationEntry;
  prevHref: string | null;
  nextHref: string | null;
  previousEntry: CourseNavigationEntry | null;
  nextEntry: CourseNavigationEntry | null;
  previousInitiallyEnabled: boolean;
  nextInitiallyEnabled: boolean;
};

const { type, section } = Astro.props;
const includeDrafts = import.meta.env.DEV;

let title: string;
let description: string;
let currentSectionId: string;
let currentLessonId: string | undefined;

if (type === 'section') {
  title = `${section.data.title} — TexDock`;
  description = section.data.description;
  currentSectionId = section.data.id;
} else {
  const p = Astro.props as PageProps;
  title = `${p.lessonPage.data.title} — TexDock`;
  description = p.lessonPage.data.description
    ?? `${p.lesson.data.description} Tema: ${p.lessonPage.data.title}.`;
  currentSectionId = p.section.data.id;
  currentLessonId = p.lesson.data.id;
}

let PageContent: any = undefined;
let pageProps: PageProps | null = null;
let hasResources = false;
if (type === 'page') {
  pageProps = Astro.props as PageProps;
  const { Content } = await render(pageProps.lessonPage);
  PageContent = Content;
  const resources = await getLessonResourcesByPageId(pageProps.lessonPage.data.id, {
    includeDrafts,
  });
  hasResources = resources.examples.length > 0 || resources.exercises.length > 0;
}
---

<CourseLayout
  title={title}
  description={description}
  currentSection={currentSectionId}
  currentLesson={currentLessonId}
  currentPage={pageProps?.lessonPage.data.id}
  lessonMode={type !== 'section'}
>
  {
    type === 'section' ? (
      <article>
        <h1>{section.data.title}</h1>
        <p class="section-description">{section.data.description}</p>
      </article>
    ) : pageProps ? (
      <article class="lesson-article">
        <h1>{pageProps.lessonPage.data.title}</h1>

        <LessonNavigation
          currentPageIndex={pageProps.entry.pageIndexInLesson}
          totalPages={pageProps.entry.totalPagesInLesson}
          previousHref={pageProps.prevHref}
          nextHref={pageProps.nextHref}
          previousSectionId={pageProps.previousEntry?.sectionId}
          previousLessonId={pageProps.previousEntry?.lessonId}
          previousPageId={pageProps.previousEntry?.pageId}
          nextSectionId={pageProps.nextEntry?.sectionId}
          nextLessonId={pageProps.nextEntry?.lessonId}
          nextPageId={pageProps.nextEntry?.pageId}
          previousInitiallyEnabled={pageProps.previousInitiallyEnabled}
          nextInitiallyEnabled={pageProps.nextInitiallyEnabled}
        />

        {PageContent && (
          <div class:list={['page-theory', currentSectionId === 'seccion-02' && 'page-theory--section-02']}>
            <PageContent />
          </div>
        )}

        {hasResources && (
          <div class="page-workspace">
            <LessonResources
              pageId={pageProps.lessonPage.data.id}
              includeDrafts={includeDrafts}
            />
          </div>
        )}
      </article>
    ) : null
  }
</CourseLayout>

<style>
  h1 {
    font-family: var(--font-mono);
    font-size: 1.375rem;
    line-height: 1.3;
    margin-bottom: var(--space-xs);
    color: var(--color-text);
  }

  .section-description {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .lesson-article {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .page-workspace {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
</style>

<!-- Los estilos de .page-theory son globales: el HTML generado por el Markdown
     (<PageContent />) no recibe el atributo de scope de Astro, por lo que los
     selectores scoped nunca alcanzarían a los párrafos, listas y bloques.
     La clase .page-theory solo se utiliza en esta página. -->
<style is:global>
  .lesson-article astro-island {
    display: block;
    width: 100%;
  }

  /* Zona de lectura educativa: columna compacta alineada a la izquierda */
  .page-theory {
    max-width: var(--max-width);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .page-theory p {
    margin: 0 0 var(--space-sm);
  }

  .page-theory h2,
  .page-theory h3,
  .page-theory h4 {
    font-family: var(--font-sans);
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text);
  }

  .page-theory h2 {
    font-size: 1.125rem;
    margin: var(--space-md) 0 var(--space-xs);
  }

  .page-theory h3 {
    font-size: 1rem;
    margin: var(--space-md) 0 var(--space-xs);
  }

  .page-theory h4 {
    font-size: 0.9375rem;
    margin: var(--space-sm) 0 var(--space-xs);
  }

  .page-theory ul,
  .page-theory ol {
    margin: 0 0 var(--space-sm);
    padding-left: 1.375rem;
  }

  .page-theory li {
    margin-bottom: var(--space-xs);
    line-height: 1.55;
  }

  .page-theory li:last-child {
    margin-bottom: 0;
  }

  .page-theory li > ul,
  .page-theory li > ol {
    margin-top: var(--space-xs);
    margin-bottom: 0;
    padding-left: clamp(1.15rem, 3vw, 1.6rem);
  }

  .page-theory ul {
    list-style-type: disc;
  }

  .page-theory ul ul {
    list-style-type: circle;
  }

  .page-theory ul ul ul {
    list-style-type: square;
  }

  .page-theory ol {
    list-style-type: decimal;
  }

  .page-theory ol ol {
    list-style-type: lower-alpha;
  }

  .page-theory ol ol ol {
    list-style-type: lower-roman;
  }

  .page-theory li > ul > li,
  .page-theory li > ol > li {
    padding-left: 0.15rem;
  }

  .page-theory code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .page-theory pre {
    margin: 0 0 var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .page-theory pre code {
    padding: 0;
    background: none;
    border: none;
    font-size: inherit;
  }

  .page-theory strong {
    font-weight: 600;
  }

  .page-theory em {
    font-style: italic;
  }

  .page-theory a {
    color: var(--color-code);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .page-theory blockquote {
    margin: 0 0 var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    border-left: 3px solid var(--color-border-strong);
    color: var(--color-text-secondary);
  }

  .page-theory blockquote p:last-child {
    margin-bottom: 0;
  }

  /* Bloques pedagógicos: párrafos que abren con una etiqueta en negrita
     (Idea clave, Actividad, Ejercicio, Criterio de éxito, Propósito, Alcance).
     La etiqueta se muestra pequeña en su propia línea y el bloque se distingue
     con un borde lateral discreto y un fondo apenas diferenciado. */
  .page-theory p:has(> strong:first-child) {
    margin: var(--space-md) 0;
    padding: var(--space-sm) var(--space-md);
    border-left: 3px solid var(--color-navigation);
    background: var(--color-surface-subtle);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .page-theory p:has(> strong:first-child) > strong:first-child {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-navigation);
    width: fit-content;
    margin-bottom: 0.4rem;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-navigation) 35%, transparent);
  }

  /* Varias etiquetas Markdown consecutivas pertenecen al mismo <p>.
     Convertir cada etiqueta posterior en un bloque evita que «Idea»,
     «Ejemplo» o «Criterio» se mezclen en una única línea. */
  .page-theory p:has(> strong:first-child) > strong:not(:first-child) {
    display: block;
    width: fit-content;
    margin-top: var(--space-sm);
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-navigation);
  }

  /* Si la instrucción va seguida de una lista, la lista continúa el bloque */
  .page-theory p:has(> strong:first-child):has(+ ul, + ol) {
    margin-bottom: 0;
    padding-bottom: var(--space-xs);
    border-radius: 0 var(--radius-sm) 0 0;
  }

  .page-theory p:has(> strong:first-child) + ul,
  .page-theory p:has(> strong:first-child) + ol {
    margin: 0 0 var(--space-md);
    padding: var(--space-xs) var(--space-md) var(--space-md) calc(var(--space-md) + 1.375rem);
    border-left: 3px solid var(--color-navigation);
    background: var(--color-surface-subtle);
    border-radius: 0 0 var(--radius-sm) 0;
  }

  .page-theory p:has(> strong:first-child) + ul > li,
  .page-theory p:has(> strong:first-child) + ol > li {
    margin-bottom: var(--space-xs);
  }

  .page-theory p:has(> strong:first-child) + ul > li:last-child,
  .page-theory p:has(> strong:first-child) + ol > li:last-child {
    margin-bottom: 0;
  }

  .page-theory p:has(> strong:first-child) + pre,
  .page-theory p:has(> strong:first-child) + blockquote {
    margin-top: calc(-1 * var(--space-sm));
  }

  .page-theory p:has(> strong:first-child) code {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  /* Si el bloque abre la página, no añadir espacio extra superior */
  .page-theory > p:first-child:has(> strong:first-child) {
    margin-top: 0;
  }

  /* === Bloques de ejemplo ===
     Acento azul/cian exclusivo. Nunca rojo.
     Anula explícitamente los selectores pedagógicos generales
     que aplican border-left y color rojo a p:has(>strong). */
  .page-theory .example-block {
    margin: var(--space-md) 0;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-code);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--color-surface-subtle);
  }

  /* Anular completamente herencia roja del bloque pedagógico general
     tanto en la cabecera como en la lista adyacente. */
  .page-theory .example-block p:has(> strong:first-child),
  .page-theory .example-block p:has(> strong:first-child) + ul,
  .page-theory .example-block p:has(> strong:first-child) + ol {
    border-left: none;
    background: transparent;
    border-radius: 0;
  }

  .page-theory .example-block p:has(> strong:first-child) > strong:first-child {
    color: var(--color-code);
  }

  /* Cabecera del bloque */
  .page-theory .example-block > p:has(> strong:first-child) {
    margin: 0;
    padding: var(--space-xs) var(--space-sm) 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-code);
  }

  /* Listas dentro del bloque */
  .page-theory .example-block ul,
  .page-theory .example-block ol {
    margin: 0;
    padding: var(--space-xs) var(--space-sm) var(--space-sm) calc(var(--space-sm) + 1.375rem);
  }

  .page-theory .example-block ul {
    list-style: disc;
  }

  .page-theory .example-block ol {
    list-style: decimal;
  }

  .page-theory .example-block li > ul,
  .page-theory .example-block li > ol {
    margin-top: var(--space-xs);
    padding: 0 0 0 clamp(1.15rem, 3vw, 1.55rem);
  }

  .page-theory .example-block ul ul {
    list-style-type: circle;
  }

  .page-theory .example-block ul ul ul {
    list-style-type: square;
  }

  .page-theory .example-block ol ol {
    list-style-type: lower-alpha;
  }

  .page-theory .example-block ol ol ol {
    list-style-type: lower-roman;
  }

  /* Ítems: separador neutro sutil */
  .page-theory .example-block ul > li,
  .page-theory .example-block ol > li {
    margin-bottom: var(--space-xs);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    line-height: 1.5;
    color: var(--color-text);
  }

  .page-theory .example-block ul > li:last-child,
  .page-theory .example-block ol > li:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  /* Caso arriba */
  .page-theory .example-block li > p:first-child {
    margin-bottom: 0.125rem;
    font-weight: 500;
  }

  /* Respuesta / clasificación / criterio abajo */
  .page-theory .example-block li > p:not(:first-child) {
    margin-top: 0.125rem;
    margin-bottom: 0;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  /* Destacar respuesta o clasificación con acento */
  .page-theory .example-block li > p:not(:first-child) strong,
  .page-theory .example-block li > p:not(:first-child) code {
    color: var(--color-code);
    font-weight: 600;
  }

  .page-theory .example-block li > p:not(:first-child) code {
    background: var(--color-code-soft);
    border-color: var(--color-border);
    font-size: 0.85em;
  }

  /* === Ancho ampliado para Sección 2 === */
  .page-theory--section-02 {
    max-width: 920px;
  }
  .page-theory--section-02 p {
    max-width: 68ch;
  }

  /* === Estructura visual del documento (PREÁMBULO / CUERPO) === */
  .doc-structure {
    margin: var(--space-md) 0 var(--space-sm);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
  }
  .ds-row {
    display: grid;
    grid-template-columns: minmax(140px, auto) 1fr;
    border-bottom: 1px solid var(--color-border);
  }
  .ds-row:last-child {
    border-bottom: none;
  }
  .ds-zone {
    padding: var(--space-sm) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    border-right: 1px solid var(--color-border);
  }
  .ds-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ds-desc {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.3;
  }
  .ds-code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    padding: var(--space-sm) var(--space-md);
    margin: 0;
    white-space: pre;
    overflow-x: auto;
  }
  /* Preámbulo: azul/cian */
  .ds-preamble {
    background: color-mix(in srgb, var(--color-code) 8%, var(--color-surface));
  }
  .ds-preamble .ds-label {
    color: var(--color-code);
  }
  /* Cuerpo: neutro */
  .ds-body {
    background: var(--color-surface);
  }
  .ds-body .ds-label {
    color: var(--color-text);
  }
  /* Límites \begin / \end */
  .ds-boundary {
    background: var(--color-bg);
  }
  .ds-boundary .ds-label {
    color: var(--color-text-secondary);
  }
  .ds-bcode {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.02em;
    padding: var(--space-sm) var(--space-md);
    display: flex;
    align-items: center;
  }
  @media (max-width: 768px) {
    .ds-row {
      grid-template-columns: 1fr;
    }
    .ds-zone {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      flex-direction: row;
      gap: var(--space-sm);
      align-items: baseline;
    }
    .ds-code,
    .ds-bcode {
      padding-top: 0;
    }
  }
</style>
