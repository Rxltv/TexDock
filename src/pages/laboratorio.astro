---
import BaseLayout from '../layouts/BaseLayout.astro';
import MathPlayground from '../components/playground/MathPlayground';
---

<BaseLayout
  title="Fórmulas LaTeX — TexDock"
  description="Escribe, visualiza y descarga fórmulas LaTeX en SVG y PNG."
  hideFooter
  pageLayout="practice"
>
  <main class="practice-page" id="main-content">
    <MathPlayground client:load />
  </main>
</BaseLayout>

<style is:global>
  .practice-page {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .math-playground {
    --formula-box-height: 360px;
    --formula-font-scale: 1.3;
    width: min(100% - 48px, 1280px);
    min-width: 0;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
  }

  .playground-heading h1 {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    margin: 0;
  }

  .playground-heading p {
    color: var(--color-text-secondary);
    margin-top: var(--space-xs);
  }

  .playground-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-lg);
    min-width: 0;
  }

  .math-playground .input-panel,
  .math-playground .preview-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .math-playground .input-label {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-sm);
  }

  .math-playground .input-panel .latex-editor-wrapper {
    flex: 0 0 var(--formula-box-height);
    width: 100%;
    min-width: 0;
    height: var(--formula-box-height);
    min-height: 0;
    box-sizing: border-box;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .math-playground .input-panel .editor-mount {
    min-width: 0;
    min-height: 0;
  }

  .math-playground .cm-content {
    font-size: 1rem;
    line-height: 1.7;
    padding: 0.75rem 1rem;
  }

  .math-playground .cm-line {
    line-height: 1.7;
  }

  .math-playground .cm-gutters {
    font-size: 0.9375rem;
    padding-block: 0.75rem;
  }

  .math-playground .cm-lineNumbers .cm-gutterElement {
    min-width: 2.75rem;
    padding-inline: 0.625rem;
  }

  .cm-tooltip-autocomplete {
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 24px rgb(0 0 0 / 22%);
    box-sizing: border-box;
    color: var(--color-text);
    max-width: min(30rem, calc(100vw - 1rem));
    min-width: min(18rem, calc(100vw - 1rem));
    overflow: hidden;
    padding: 0.25rem;
    z-index: 10;
  }

  .cm-tooltip-autocomplete > ul {
    list-style: none;
    max-height: 16rem;
    overflow: hidden !important;
    overflow-y: hidden !important;
    scrollbar-width: none;
  }

  .cm-tooltip-autocomplete > ul::-webkit-scrollbar {
    display: none;
  }

  .cm-tooltip-autocomplete .cm-completionIcon {
    display: none;
    height: 0;
    margin: 0;
    min-width: 0;
    padding: 0;
    width: 0;
  }

  .cm-tooltip-autocomplete > ul > li {
    align-items: center;
    border-left: 2px solid transparent;
    color: var(--color-text);
    display: flex;
    gap: 0.75rem;
    line-height: 1.35;
    min-width: 0;
    padding: 0.4rem 0.55rem;
    transition: background-color 0.12s, border-color 0.12s;
  }

  .cm-tooltip-autocomplete > ul > li:hover {
    background: var(--color-surface-subtle) !important;
  }

  .cm-tooltip-autocomplete > ul > li[aria-selected="true"] {
    background: var(--color-surface-elevated) !important;
    border-left-color: var(--color-practice) !important;
  }

  .cm-tooltip-autocomplete .cm-completionLabel {
    color: var(--color-text);
    flex: 1 1 auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cm-tooltip-autocomplete .cm-completionDetail {
    color: var(--color-text-secondary);
    flex: 0 1 11rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 400;
    min-width: 0;
    overflow: hidden;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cm-tooltip-autocomplete > ul > li[aria-selected="true"] .cm-completionLabel {
    color: var(--color-text) !important;
  }

  .cm-tooltip-autocomplete > ul > li[aria-selected="true"] .cm-completionDetail {
    color: var(--color-text-secondary) !important;
  }

  .math-playground .preview-container {
    flex: 0 0 var(--formula-box-height);
    width: 100%;
    min-width: 0;
    height: var(--formula-box-height);
    min-height: 0;
    box-sizing: border-box;
    display: flex;
    align-items: safe center;
    justify-content: safe center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    padding: var(--space-lg);
    overflow: auto;
    scrollbar-color: var(--color-border-strong) var(--color-surface-subtle);
    scrollbar-width: thin;
  }

  .math-playground .preview-container::-webkit-scrollbar {
    height: 10px;
    width: 10px;
  }

  .math-playground .preview-container::-webkit-scrollbar-track {
    background: var(--color-surface-subtle);
    border-radius: var(--radius-sm);
  }

  .math-playground .preview-container::-webkit-scrollbar-thumb {
    background: var(--color-border-strong);
    border: 2px solid var(--color-surface-subtle);
    border-radius: var(--radius-sm);
  }

  .math-playground .preview-container::-webkit-scrollbar-thumb:hover {
    background: var(--color-text-secondary);
  }

  .math-playground .preview-container .katex-display {
    flex: 0 0 auto;
    margin: 0;
    font-size: calc(var(--formula-font-scale) * 1em);
  }

  .math-playground .preview-container .katex {
    font-size: calc(var(--formula-font-scale) * 1em);
  }

  .status-message {
    text-align: center;
    font-size: 0.875rem;
  }

  .status-idle {
    color: var(--color-text-secondary);
  }

  .status-valid {
    color: var(--color-success);
    font-weight: 600;
  }

  .status-action {
    color: var(--color-text);
    font-weight: 600;
  }

  .status-generating {
    color: var(--color-practice);
    font-weight: 600;
  }

  .status-error {
    color: var(--color-danger);
  }

  .status-error p {
    margin: 0;
  }

  .status-error details {
    margin-top: var(--space-xs);
    font-size: 0.75rem;
  }

  .status-error summary {
    cursor: pointer;
    color: var(--color-text-secondary);
  }

  .status-error pre {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-xs);
    margin-top: var(--space-xs);
    overflow-x: auto;
    white-space: pre-wrap;
  }

  .formula-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .formula-action-btn {
    min-height: 42px;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }

  .formula-action-btn:hover:not(:disabled) {
    background: var(--color-surface-elevated);
    border-color: var(--color-text-secondary);
  }

  .formula-action-btn--primary {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-bg);
  }

  .formula-action-btn--primary:hover:not(:disabled) {
    background: var(--color-text-secondary);
    border-color: var(--color-text-secondary);
    color: var(--color-bg);
  }

  .formula-action-btn:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .formula-action-btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .examples-section h2 {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 0 0 var(--space-sm);
  }

  .examples-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .example-btn {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    line-height: 1.4;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }

  .example-btn:hover {
    background: var(--color-bg);
    border-color: var(--color-code);
  }

  .example-btn[aria-pressed="true"] {
    background: var(--color-code-soft);
    border-color: var(--color-code);
    font-weight: 600;
  }

  .example-btn:focus-visible {
    outline: 2px solid var(--color-code);
    outline-offset: 2px;
  }

  @media (width <= 768px) {
    .math-playground {
      --formula-box-height: 240px;
      --formula-font-scale: 1.18;
    }

    .math-playground .cm-content {
      font-size: 0.9375rem;
      line-height: 1.6;
      padding: 0.625rem 0.75rem;
    }

    .math-playground .cm-line {
      line-height: 1.6;
    }

    .math-playground .cm-gutters {
      font-size: 0.875rem;
      padding-block: 0.625rem;
    }

    .math-playground .cm-lineNumbers .cm-gutterElement {
      min-width: 2.5rem;
      padding-inline: 0.5rem;
    }

    .cm-tooltip-autocomplete {
      max-width: calc(100vw - 1rem);
      min-width: calc(100vw - 1rem);
    }

    .cm-tooltip-autocomplete > ul > li {
      gap: 0.5rem;
    }

    .cm-tooltip-autocomplete .cm-completionDetail {
      flex-basis: 8rem;
    }

    .playground-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .math-playground {
      width: min(100% - 32px, 1280px);
      padding: var(--space-md) 0;
    }

    .formula-actions {
      align-items: stretch;
    }

    .formula-action-btn {
      flex: 1 1 10rem;
    }
  }
</style>
