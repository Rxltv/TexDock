---
import BaseLayout from '../layouts/BaseLayout.astro';
import MathPlayground from '../components/playground/MathPlayground';
import PreamblePanel from '../components/playground/PreamblePanel.astro';
---

<BaseLayout title="Laboratorio matemático — TexDock">
  <main>
    <PreamblePanel />
    <MathPlayground client:load />
  </main>
</BaseLayout>

<style is:global>
  .math-playground {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-lg);
  }

  .math-playground h1 {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
    color: var(--color-text);
  }

  .proto-note {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    margin-bottom: var(--space-lg);
    line-height: 1.6;
  }

  .examples-section {
    margin-bottom: var(--space-lg);
  }

  .examples-section h2 {
    font-family: var(--font-mono);
    font-size: 1rem;
    margin-bottom: var(--space-sm);
    color: var(--color-text);
  }

  .examples-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .example-btn {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .example-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .example-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .example-btn[aria-pressed="true"] {
    background: var(--color-accent-dim);
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .playground-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .input-panel label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: var(--space-sm);
    color: var(--color-text);
  }

  .input-panel textarea {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    line-height: 1.6;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    resize: vertical;
    min-height: 6rem;
  }

  .input-panel textarea:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -1px;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    flex-wrap: wrap;
  }

  .actions button {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    padding: var(--space-xs) var(--space-md);
    background: var(--color-accent-dim);
    color: var(--color-text);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .actions button:hover {
    background: var(--color-accent);
  }

  .actions button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .shortcut-hint {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .preview-panel {
    min-height: 8rem;
  }

  .preview-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 6rem;
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow-x: auto;
  }

  .preview-container .katex-display {
    margin: 0;
  }

  .status-message {
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .status-valid {
    color: var(--color-success);
    font-weight: 600;
  }

  .status-error p {
    color: var(--color-danger);
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .status-error details {
    margin-top: var(--space-xs);
    color: var(--color-text-secondary);
  }

  .status-error details summary {
    cursor: pointer;
    color: var(--color-accent);
  }

  .status-error details summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .status-error details pre {
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: var(--space-sm);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .back-link {
    display: inline-block;
    margin-top: var(--space-xl);
    font-size: 0.9375rem;
    color: var(--color-accent);
  }

  .back-link:hover {
    color: var(--color-accent-dim);
  }

  @media (width <= 640px) {
    .playground-layout {
      grid-template-columns: 1fr;
    }

    .math-playground {
      padding: var(--space-md);
    }

    .examples-grid {
      gap: var(--space-xs);
    }

    .example-btn {
      font-size: 0.75rem;
      padding: var(--space-xs);
    }
  }
</style>
