---
export interface Props {
  currentPageIndex: number;
  totalPages: number;
  previousHref: string | null;
  nextHref: string | null;
  previousSectionId?: string;
  previousLessonId?: string;
  previousPageId?: string;
  nextSectionId?: string;
  nextLessonId?: string;
  nextPageId?: string;
  previousInitiallyEnabled?: boolean;
  nextInitiallyEnabled?: boolean;
}

const {
  currentPageIndex,
  totalPages,
  previousHref,
  nextHref,
  previousSectionId,
  previousLessonId,
  previousPageId,
  nextSectionId,
  nextLessonId,
  nextPageId,
  previousInitiallyEnabled = false,
  nextInitiallyEnabled = false,
} = Astro.props;
---

<nav aria-label="Navegación de la lección">
  <div class="nav-container">
    {
      previousHref ? (
        <a
          href={previousInitiallyEnabled ? previousHref : undefined}
          data-progress-navigation
          data-progress-href={previousHref}
          data-progress-target-section={previousSectionId}
          data-progress-target-lesson={previousLessonId}
          data-progress-target-page={previousPageId}
          rel="prev"
          class:list={['nav-link', 'nav-prev', !previousInitiallyEnabled && 'nav-link--disabled']}
          aria-disabled={previousInitiallyEnabled ? undefined : 'true'}
          tabindex={previousInitiallyEnabled ? undefined : -1}
        >
          ← Anterior
        </a>
      ) : (
        <span class="nav-link nav-link--disabled" aria-disabled="true">
          ← Anterior
        </span>
      )
    }

    <span class="page-indicator">
      Página {currentPageIndex + 1} de {totalPages}
    </span>

    {
      nextHref ? (
        <a
          href={nextInitiallyEnabled ? nextHref : undefined}
          data-progress-navigation
          data-progress-href={nextHref}
          data-progress-target-section={nextSectionId}
          data-progress-target-lesson={nextLessonId}
          data-progress-target-page={nextPageId}
          rel="next"
          class:list={['nav-link', 'nav-next', !nextInitiallyEnabled && 'nav-link--disabled']}
          aria-disabled={nextInitiallyEnabled ? undefined : 'true'}
          tabindex={nextInitiallyEnabled ? undefined : -1}
        >
          Continuar →
        </a>
      ) : (
        <span class="nav-link nav-link--disabled" aria-disabled="true">
          Continuar →
        </span>
      )
    }
  </div>
</nav>

<style>
  nav {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-width: 0;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-text);
    transition: background-color 0.15s;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .nav-link:hover {
    background: var(--color-surface);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* Estado deshabilitado: atenuado pero con contraste suficiente y sin eventos */
  .nav-link--disabled {
    color: var(--color-text-secondary);
    opacity: 0.5;
    cursor: default;
    pointer-events: none;
  }

  .page-indicator {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  @media (width <= 480px) {
    .nav-container {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }

    .page-indicator {
      grid-column: 1 / -1;
      grid-row: 1;
      text-align: center;
    }

    .nav-prev {
      grid-column: 1;
      grid-row: 2;
      justify-self: start;
    }

    .nav-next {
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
      text-align: right;
    }
  }
</style>
