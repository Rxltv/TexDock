---
export interface Props {
  currentPageIndex: number;
  totalPages: number;
  previousHref: string | null;
  nextHref: string | null;
}

const { currentPageIndex, totalPages, previousHref, nextHref } = Astro.props;
---

<nav aria-label="Navegación de la lección">
  <div class="nav-container">
    {
      previousHref ? (
        <a href={previousHref} rel="prev" class="nav-link nav-prev">
          ← Anterior
        </a>
      ) : (
        <span class="nav-link nav-link--disabled" aria-disabled="true">
          ← Anterior
        </span>
      )
    }

    <span class="page-indicator">
      Página {currentPageIndex + 1} de {totalPages}
    </span>

    {
      nextHref ? (
        <a href={nextHref} rel="next" class="nav-link nav-next">
          Continuar →
        </a>
      ) : (
        <span class="nav-link nav-link--disabled" aria-disabled="true">
          Continuar →
        </span>
      )
    }
  </div>
</nav>

<style>
  nav {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-text);
    transition: background-color 0.15s;
  }

  .nav-link:hover {
    background: var(--color-surface);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .nav-link--disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  .page-indicator {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }
</style>
