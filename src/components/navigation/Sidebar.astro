---
import type { SidebarData } from '../../lib/content/courseSidebarData';

export interface Props {
  sidebarData: SidebarData;
}

const { sidebarData } = Astro.props;
const { sections, lessonsBySection, currentSectionId, currentLessonId } = sidebarData;
---

<aside class="sidebar" aria-label="Navegación del curso">
  <div class="sidebar-header">
    <a href="/aprender/" class="sidebar-title">Curso básico</a>
  </div>
  <nav aria-label="Secciones del curso">
    <ul class="section-list">
      {sections.map((section) => {
        const isCurrent = section.id === currentSectionId;
        const sectionLessons = lessonsBySection[section.id] || [];

        return (
          <li class="section-item">
            {section.href ? (
              <a
                href={section.href}
                class="section-link"
                aria-current={isCurrent && !currentLessonId ? 'page' : undefined}
              >
                <span class="section-number">{String(section.order).padStart(2, '0')}</span>
                <span class="section-title">{section.title}</span>
              </a>
            ) : (
              <span class="section-link section-link--disabled" aria-disabled="true">
                <span class="section-number">{String(section.order).padStart(2, '0')}</span>
                <span class="section-title">{section.title}</span>
              </span>
            )}

            {isCurrent && sectionLessons.length > 1 && (
              <ul class="lesson-list">
                {sectionLessons.map((lesson) => {
                  const isActive = lesson.id === currentLessonId;
                  return (
                    <li class="lesson-item">
                      {lesson.href ? (
                        <a
                          href={lesson.href}
                          class="lesson-link"
                          aria-current={isActive ? 'page' : undefined}
                        >
                          {lesson.title}
                        </a>
                      ) : (
                        <span class="lesson-link lesson-link--disabled" aria-disabled="true">
                          {lesson.title}
                        </span>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}
          </li>
        );
      })}
    </ul>
  </nav>
</aside>

<style>
  .sidebar {
    width: 280px;
    flex-shrink: 0;
    min-height: 0;
    border-right: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow-y: auto;
    overflow-x: hidden;
  }

  .sidebar-header {
    padding: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background: var(--color-surface);
    z-index: 1;
  }

  .sidebar-title {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
  }

  .sidebar-title:hover {
    color: var(--color-text-secondary);
  }

  .sidebar-title:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .section-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .section-item {
    margin: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .section-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    text-decoration: none;
    font-size: 0.875rem;
    color: var(--color-text);
    width: 100%;
    box-sizing: border-box;
  }

  .section-link:hover {
    background: var(--color-bg);
  }

  .section-link[aria-current="page"] {
    background: var(--color-surface-subtle);
    font-weight: 600;
  }

  .section-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  .section-link--disabled {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
  }

  .section-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    min-width: 2ch;
  }

  .section-title {
    font-weight: 500;
  }

  .lesson-list {
    list-style: none;
    padding: 0 0 var(--space-xs) 0;
    margin: 0;
  }

  .lesson-item {
    margin: 0;
  }

  .lesson-link {
    display: block;
    padding: var(--space-2xs) var(--space-md) var(--space-2xs) calc(var(--space-md) + 2.5ch);
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    border-left: 2px solid transparent;
    line-height: 1.5;
  }

  .lesson-link:hover {
    color: var(--color-text);
    background: var(--color-bg);
  }

  .lesson-link[aria-current="page"] {
    color: var(--color-text);
    border-left-color: var(--color-navigation);
    background: var(--color-surface-subtle);
    font-weight: 600;
  }

  .lesson-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  .lesson-link--disabled {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
  }

  @media (width <= 768px) {
    .sidebar {
      width: 100%;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      overflow-y: visible;
    }

    .sidebar-header {
      position: static;
    }
  }
</style>
