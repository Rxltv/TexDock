---
export interface Props {
  sections: Array<{ id: string; title: string; order: number }>;
  currentSection?: string;
}

const { sections, currentSection } = Astro.props;
---

<aside class="sidebar" aria-label="Navegación del curso">
  <div class="sidebar-header">
    <span class="sidebar-title">Curso básico</span>
  </div>
  <nav aria-label="Secciones del curso">
    <a
      href="/aprender/"
      class="nav-link"
      aria-current={currentSection ? undefined : 'page'}
    >
      <svg class="nav-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 7L7 1.5L13 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M3 5.5V12H11V5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Inicio
    </a>
    <div class="sidebar-divider" role="separator"></div>
    <ol class="section-list">
      {
        sections.map((section) => (
          <li class="section-item">
            <a
              href={`/aprender/${section.id}`}
              class="nav-link"
              aria-current={section.id === currentSection ? 'page' : undefined}
            >
              <span class="section-number">{String(section.order).padStart(2, '0')}</span>
              <span class="section-title">{section.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</aside>

<style>
  .sidebar {
    width: 280px;
    flex-shrink: 0;
    min-height: 0;
    border-right: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow-y: auto;
  }

  .sidebar-header {
    padding: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background: var(--color-surface);
    z-index: 1;
  }

  .sidebar-title {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .section-list {
    list-style: none;
    padding: 0;
  }

  .section-item {
    margin: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    text-decoration: none;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    border-left: 2px solid transparent;
    width: 100%;
  }

  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-bg);
  }

  .nav-link[aria-current="page"] {
    color: var(--color-text);
    border-left-color: var(--color-navigation);
    background: var(--color-surface-subtle);
    font-weight: 700;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  .nav-icon {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .nav-link[aria-current="page"] .nav-icon {
    opacity: 1;
  }

  .sidebar-divider {
    height: 1px;
    background: var(--color-border);
    margin: var(--space-xs) var(--space-md);
  }

  .section-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    min-width: 2ch;
  }

  .nav-link[aria-current="page"] .section-number {
    color: var(--color-text-secondary);
  }

  @media (width <= 768px) {
    .sidebar {
      width: 100%;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      overflow-y: visible;
    }

    .sidebar-header {
      position: static;
    }

    .section-list {
      display: flex;
      overflow-x: auto;
      gap: 0;
      padding: 0;
    }

    .section-item {
      flex-shrink: 0;
    }

    .nav-link {
      border-left: none;
      border-bottom: 2px solid transparent;
      padding: var(--space-sm) var(--space-md);
      white-space: nowrap;
      width: auto;
    }

    .nav-link[aria-current="page"] {
      border-left-color: transparent;
      border-bottom-color: var(--color-navigation);
    }

    .sidebar-divider {
      display: none;
    }
  }
</style>
