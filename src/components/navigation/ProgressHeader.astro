---
export interface Props {
  currentSectionOrder?: number;
  totalSections: number;
}

const { currentSectionOrder, totalSections } = Astro.props;
---

<div class="progress-header" role="region" aria-label="Progreso del curso">
  <div class="progress-info">
    <span class="progress-label">Curso de LaTeX</span>
    <span class="progress-value">
      {currentSectionOrder
        ? `Sección ${currentSectionOrder} de ${totalSections}`
        : `${totalSections} secciones`}
    </span>
  </div>
</div>

<style>
  .progress-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-xs) var(--space-lg);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }

  .progress-info {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .progress-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .progress-value {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  @media (width <= 640px) {
    .progress-header {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-xs) var(--space-md);
    }
  }
</style>
