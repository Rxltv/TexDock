---
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../../lib/urls';
---

<header class="site-header">
  <nav class="nav" aria-label="Navegación principal">
    <a href={url('/')} class="logo">TexDock</a>
    <span class="beta-badge">Fase 1 Beta</span>
    <ul class="nav-links">
      <li><a href={url('/aprender')}>Aprender</a></li>
      <li><a href={url('/biblioteca')}>Biblioteca</a></li>
      <li><a href={url('/laboratorio')}>Fórmulas</a></li>
      <li><a href={url('/acerca')}>Acerca de</a></li>
      <li><a href="https://github.com/Rxltv/TexDock" target="_blank" rel="noopener noreferrer">GitHub</a></li>
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    max-width: 960px;
    min-width: 0;
    margin: 0 auto;
    padding: var(--space-sm) var(--space-lg);
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text);
    text-decoration: none;
    min-width: 0;
    margin-right: auto;
  }

  .logo:hover {
    color: var(--color-text);
  }

  .beta-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.125rem 0.375rem;
    line-height: 1.3;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: var(--space-md);
  }

  .nav-links a {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius);
  }

  .nav-links a:hover {
    color: var(--color-text);
    background: var(--color-bg);
  }

  .nav-links a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  @media (width <= 640px) {
    .nav {
      padding: var(--space-sm) var(--space-md);
      flex-wrap: wrap;
    }

    .nav-links {
      order: 3;
      flex: 1 1 100%;
      min-width: 0;
      gap: var(--space-xs);
      flex-wrap: wrap;
    }

    .nav-links a {
      font-size: 0.8125rem;
      padding: var(--space-xs);
    }
  }
</style>
