---
import type { ProgressCourseGraph } from '../../lib/progress/types';
import { url } from '../../lib/urls';

export interface Props {
  graph: ProgressCourseGraph;
  currentSection?: string;
  currentLesson?: string;
  currentPage?: string;
}

const { graph, currentSection, currentLesson, currentPage } = Astro.props;
const redirectHref = url('/aprender/');
const progressData = JSON.stringify({ graph, currentSection, currentLesson, currentPage, redirectHref });
---

<script is:inline type="application/json" id="texdock-progress-data" set:html={progressData}></script>

<script>
  import { mountProgressRuntime } from '../../lib/progress/progressRuntime';
  import type { ProgressCourseGraph } from '../../lib/progress/types';

  interface ProgressData {
    graph: ProgressCourseGraph;
    currentSection?: string;
    currentLesson?: string;
    currentPage?: string;
    redirectHref: string;
  }

  const dataElement = document.getElementById('texdock-progress-data');
  if (dataElement) {
    const data = JSON.parse(dataElement.textContent || '{}') as ProgressData;
    let storage: Storage | null = null;
    for (const candidate of [() => window.localStorage, () => window.sessionStorage]) {
      try {
        const availableStorage = candidate();
        const probeKey = 'texdock:storage-probe';
        availableStorage.setItem(probeKey, '1');
        availableStorage.removeItem(probeKey);
        storage = availableStorage;
        break;
      } catch {
        storage = null;
      }
    }
    mountProgressRuntime({
      ...data,
      document,
      eventTarget: window,
      storage,
      navigate: (href) => window.location.replace(href),
      confirmReset: () => window.confirm('¿Quieres borrar el progreso guardado en este navegador?'),
    });
  }
</script>
