---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/navigation/Sidebar.astro';
import ProgressHeader from '../components/navigation/ProgressHeader.astro';
import { getCollection } from 'astro:content';
import { buildSidebarData } from '../lib/content/courseSidebarData';
import { isVisible } from '../lib/content/courseRouteData';
import { buildProgressGraph } from '../lib/progress/courseProgress';
import ProgressClient from '../components/progress/ProgressClient.astro';

export interface Props {
  title: string;
  description: string;
  currentSection?: string;
  currentLesson?: string;
  currentPage?: string;
  lessonMode?: boolean;
  mobileSectionsDropdown?: boolean;
}

const { title, description, lessonMode = false, mobileSectionsDropdown = true } = Astro.props;
const sections = await getCollection('section');
const allLessons = await getCollection('lesson');
const allPages = await getCollection('lessonPage');
const allExercises = await getCollection('exercise');
const isDev = import.meta.env.DEV;

const sectionInputs = sections
  .map((s) => ({ id: s.data.id, title: s.data.title, order: s.data.order }))
  .sort((a, b) => a.order - b.order);

const visibleLessonData = allLessons
  .map((l) => l.data)
  .filter((l) => isVisible(l, isDev));

const visiblePageData = allPages
  .map((p) => p.data)
  .filter((p) => isVisible(p, isDev));
const visibleExerciseData = allExercises
  .map((e) => e.data)
  .filter((e) => isVisible(e, isDev));

const navLessons = visibleLessonData.map((l) => ({
  id: l.id,
  sectionId: l.sectionId,
  order: l.order,
  title: l.title,
}));

const navPages = visiblePageData.map((p) => ({
  id: p.id,
  lessonId: p.lessonId,
  slug: p.slug,
  order: p.order,
}));

const sidebarData = buildSidebarData(
  sectionInputs,
  navLessons,
  navPages,
  Astro.props.currentSection || null,
  Astro.props.currentLesson || null,
);

const sidebarSections = sidebarData.sections;
const currentSectionData = Astro.props.currentSection
  ? sidebarSections.find((s) => s.id === Astro.props.currentSection)
  : undefined;

const totalSections = sidebarSections.length;
const progressGraph = buildProgressGraph(
  sectionInputs,
  navLessons,
  navPages,
  visibleExerciseData.map((exercise) => ({
    id: exercise.id,
    pageId: exercise.pageId,
    required: exercise.required,
  })),
);
const requiresProgressAuthorization = Boolean(Astro.props.currentSection);
---

<BaseLayout
  title={title}
  description={description}
  type={lessonMode ? 'article' : 'website'}
  hideFooter
  pageLayout={lessonMode ? 'lesson' : undefined}
>
  <div class="course-root" data-lesson-mode={lessonMode ? '' : undefined}>
    <ProgressHeader
      currentSectionOrder={currentSectionData?.order}
      totalSections={totalSections}
    />
    <div class="course-body">
      <Sidebar sidebarData={sidebarData} mobileSectionsDropdown={mobileSectionsDropdown} />
      <main
        class="course-content"
        id="main-content"
        data-course-content
        aria-busy={requiresProgressAuthorization ? 'true' : undefined}
        hidden={requiresProgressAuthorization || undefined}
        inert={requiresProgressAuthorization || undefined}
      >
        <slot />
      </main>
      {requiresProgressAuthorization && (
        <noscript>
          <p class="course-script-notice">
            Activa JavaScript para verificar el progreso y abrir esta página del curso.
          </p>
        </noscript>
      )}
    </div>
    <ProgressClient
      graph={progressGraph}
      currentSection={Astro.props.currentSection}
      currentLesson={Astro.props.currentLesson}
      currentPage={Astro.props.currentPage}
    />
  </div>
</BaseLayout>

<style>
  .course-root {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .course-body {
    flex: 1;
    min-height: 0;
    display: flex;
  }

  /* Padding superior reducido: la microlección debe empezar cerca de la parte
     superior y caber en viewports de 768 px de alto (1366 × 768) */
  .course-content {
    flex: 1;
    min-width: 0;
    min-height: 0;
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .course-content[hidden] {
    display: none;
  }

  .course-script-notice {
    margin: var(--space-lg);
    color: var(--color-text-secondary);
  }

  @media (max-width: 767px) {
    .course-body {
      flex-direction: column;
    }

    .course-content {
      padding: var(--space-md);
      overflow-y: visible;
      display: block;
    }
  }
</style>
